---
import Eyebrow from './ui/Eyebrow.astro';

/**
 * Nicole's career in four numbers, set large.
 */
const stats = [
  { value: '30', label: 'years in the fire service' },
  { value: '3,500+', label: 'fire and explosion investigations' },
  { value: '17', label: 'years as a sworn Fire/Arson Investigator' },
  { value: '4', label: 'states licensed as a private investigator' }
];
---

<div class="@container">
  <Eyebrow class="mb-8">By the numbers</Eyebrow>
  <dl class="grid border-t-2 border-foreground/15 @md:grid-cols-2 @5xl:grid-cols-4">
    {
      stats.map(({ value, label }) => (
        <div class="flex flex-col gap-3 border-b-2 border-foreground/15 py-8 @md:pr-8 @5xl:border-b-0">
          <dt class="order-2 max-w-[18ch] text-foreground/75">{label}</dt>
          <dd class="order-1 font-display text-display font-black text-primary">{value}</dd>
        </div>
      ))
    }
  </dl>
</div>
