---
import Button from './ui/Button.astro';
import Lede from './ui/Lede.astro';
import Section from './ui/Section.astro';

/**
 * The closing call to action that sends a visitor to the contact page. Sits
 * last on a page, above the footer.
 */
interface Props {
  /** Section number as shown, e.g. `4.0`. */
  number?: string;
}

const { number } = Astro.props;
---

<Section title="Contact" number={number}>
  <div class="flex flex-col items-start gap-8">
    <Lede data-reveal>
      Questions about a course, or training for your department or firm? Send me a note.
    </Lede>
    <div data-reveal>
      <Button href="/contact">Get in touch</Button>
    </div>
  </div>
</Section>
