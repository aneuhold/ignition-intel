---
import Container from '$components-astro/ui/Container.astro';
import SiteInfo from '$components-astro/SiteInfo.astro';
import siteContentService from '$util/SiteContent.service';
import Logo from '../assets/logo-gold.svg';

const socialEntry = await siteContentService.socialMediaLinks();
const { links } = socialEntry.data;
const homeEntry = await siteContentService.home();
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-foreground/10 bg-muted px-6 py-16 font-body md:py-20">
  <Container>
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <Logo class="h-12 w-auto" />
        <p class="mt-3 font-display text-xl tracking-tight">{homeEntry.data.title}</p>
      </div>
      <div class="md:text-center">
        <h2 class="mb-3 font-display text-xl tracking-tight">Contact</h2>
        <SiteInfo />
      </div>
      {links.length > 0 && (
        <div class="md:text-right">
          <h2 class="mb-3 font-display text-xl tracking-tight">Follow along</h2>
          <ul class="list-none space-y-1 p-0">
            {links.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="text-primary underline-offset-4 transition-colors duration-snap ease-soft hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-foreground/10 pt-6 text-sm text-foreground/60">
      <p>
        © {currentYear} {homeEntry.data.title}
      </p>
      <a
        href="/admin"
        class="text-foreground/40 underline-offset-4 transition-colors duration-snap ease-soft hover:text-foreground/70 hover:underline"
      >
        Staff
      </a>
    </div>
  </Container>
</footer>
