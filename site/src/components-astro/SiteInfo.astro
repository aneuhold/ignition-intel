---
import siteContentService from '$util/SiteContent.service';

const entry = await siteContentService.contact();
const { phone, email } = entry.data;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
---

<address class="not-italic font-body leading-relaxed">
  {phone && (
    <p>
      <a
        href={telHref}
        class="text-primary underline-offset-4 transition-colors duration-snap ease-soft hover:underline"
      >
        {phone}
      </a>
    </p>
  )}
  <p>
    <a
      href={`mailto:${email}`}
      class="text-primary underline-offset-4 transition-colors duration-snap ease-soft hover:underline"
    >
      {email}
    </a>
  </p>
</address>
