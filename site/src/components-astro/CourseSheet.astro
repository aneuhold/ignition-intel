---
import type { CollectionEntry } from 'astro:content';
import Frame from '$components-astro/ui/Frame.astro';
import drawingSheetService from '$util/DrawingSheet.service';

/**
 * A course as a drawing-sheet title block: sheet number, title, and description in ruled
 * cells. The whole block links to the course page.
 */
interface Props {
  course: CollectionEntry<'courses'>;
  /** Zero-based position in the sorted course list, used for the sheet number. */
  index: number;
  as?: 'li' | 'div';
}

const { course, index, as = 'li' } = Astro.props;
const { title, description } = course.data;
const label =
  'font-display text-[0.65rem] font-bold tracking-[0.22em] text-foreground/60 uppercase';
---

<Frame
  as={as}
  class="group bg-background/60 transition-colors duration-(--duration-glide) ease-soft hover:bg-background"
>
  <a
    href={`/courses/${course.id}`}
    class="flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
  >
    <div class="grid grid-cols-[1fr_auto] border-b border-foreground/15">
      <span class:list={[label, 'self-center px-5 py-3']}>Course sheet</span>
      <span
        class="border-l border-foreground/15 px-5 py-3 font-display text-xl font-bold text-primary tabular-nums"
      >
        {drawingSheetService.courseCode(index)}
      </span>
    </div>
    <div class="flex-1 px-5 py-6">
      <h3 class="font-display text-xl leading-snug font-bold text-balance text-foreground">
        {title}
      </h3>
      <p class="mt-3 line-clamp-4 text-base leading-relaxed text-foreground/75">{description}</p>
    </div>
    <div class="flex items-center gap-3 border-t border-foreground/15 px-5 py-3">
      <span class:list={[label, 'text-primary']}>View sheet</span>
      <span
        aria-hidden="true"
        class="h-px flex-1 origin-left scale-x-25 bg-primary/60 transition-transform duration-(--duration-glide) ease-soft group-hover:scale-x-100"
      ></span>
      <span aria-hidden="true" class="text-primary">&rarr;</span>
    </div>
  </a>
</Frame>
