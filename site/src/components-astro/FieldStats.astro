---
/**
 * Nicole's experience as four plain numbers with labels. Each number carries
 * `data-motion="count"` so it counts up once on first view; the visible digits
 * are hidden from assistive tech, which reads a static copy instead.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const stats = [
  { value: '3,500+', label: 'Fire and explosion investigations' },
  { value: '30', label: 'Years in the fire service' },
  { value: '18', label: 'Years as a fire/arson investigator' },
  { value: '4', label: 'States licensed as a private investigator' }
];
---

<dl class:list={['grid grid-cols-2 border-y border-foreground/15 lg:grid-cols-4', className]}>
  {
    stats.map(({ value, label }) => (
      <div class="flex flex-col-reverse justify-end gap-3 border-foreground/15 px-3 py-7 even:border-l sm:px-6 sm:py-8 [&:nth-child(n+3)]:border-t lg:[&:nth-child(n+2)]:border-l lg:[&:nth-child(n+3)]:border-t-0">
        <dt class="font-display text-[0.7rem] font-bold uppercase leading-snug tracking-[0.18em] text-foreground/70">
          {label}
        </dt>
        <dd class="font-display text-4xl font-bold tracking-tight text-primary tabular-nums sm:text-5xl xl:text-6xl">
          <span class="sr-only">{value}</span>
          <span aria-hidden="true" data-motion="count">
            {value}
          </span>
        </dd>
      </div>
    ))
  }
</dl>
