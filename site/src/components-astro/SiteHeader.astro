---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-gold.svg';
import logoFullText from '../assets/logo-full-text-gold.svg';
import { globalConstants } from '$util/globalConstants';
import Container from './ui/Container.astro';

/**
 * Sticky site header: the logo and the primary navigation, with a rust underline under the
 * current section and Contact set as the standing call to action.
 */
interface Props {
  /** Canonical pathname of the current page, e.g. `/courses/some-course`. */
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/courses', label: 'Courses' },
  { href: '/about', label: 'About' }
];
const isCurrent = (href: string): boolean =>
  currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-50 border-b border-foreground/10 bg-background/95"
>
  <Container class="flex h-16 items-center justify-between gap-6 lg:h-20">
    <a
      href="/"
      class="flex shrink-0 items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <Image src={logoMark} alt={globalConstants.siteName} class="h-9 w-auto sm:hidden" />
      <Image
        src={logoFullText}
        alt={globalConstants.siteName}
        class="hidden h-7 w-auto sm:block lg:h-8"
      />
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-5 font-display text-xs font-bold tracking-[0.18em] uppercase sm:gap-8 sm:text-sm">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class="relative py-2 text-foreground/80 transition-colors duration-(--duration-snap) ease-soft after:absolute after:inset-x-0 after:-bottom-0.5 after:h-1 after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-(--duration-glide) after:ease-soft hover:text-foreground hover:after:scale-x-100 aria-[current=page]:text-foreground aria-[current=page]:after:scale-x-100"
              >
                {label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contact"
            aria-current={isCurrent('/contact') ? 'page' : undefined}
            class="bg-accent-strong px-3 py-2.5 text-accent-foreground transition-colors duration-(--duration-snap) ease-soft hover:bg-accent-strong/85 sm:px-5 sm:py-3"
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>
  </Container>
</header>
