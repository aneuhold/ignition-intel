---
import { Image } from 'astro:assets';
import logoFullTextGold from '../assets/logo-full-text-gold.svg';
import logoGold from '../assets/logo-gold.svg';
import Container from './ui/Container.astro';
import { globalConstants } from '$util/globalConstants';

/**
 * Site header: the gold logo linking home, and the primary navigation. The
 * current section carries a rust underline.
 */
const navItems = [
  { href: '/courses', label: 'Courses' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' }
];

const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  pathname === href || pathname.startsWith(`${href}/`) || pathname === `${href}.html`;
---

<header class="border-b border-foreground/10">
  <Container class="flex h-20 items-center justify-between gap-6 sm:h-24">
    <a
      href="/"
      class="flex shrink-0 items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <Image
        src={logoGold}
        alt={globalConstants.siteName}
        class="h-10 w-auto sm:hidden"
        loading="eager"
      />
      <Image
        src={logoFullTextGold}
        alt={globalConstants.siteName}
        class="hidden h-8 w-auto sm:block"
        loading="eager"
      />
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-6 sm:gap-10">
        {
          navItems.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class:list={[
                  'font-display text-xs font-bold tracking-[0.18em] uppercase transition-colors duration-(--duration-snap) ease-soft focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary',
                  'border-b-2 pb-1.5',
                  isCurrent(href)
                    ? 'border-accent text-foreground'
                    : 'border-transparent text-foreground/65 hover:text-foreground'
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>
