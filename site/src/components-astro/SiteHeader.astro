---
import Container from './ui/Container.astro';
import LogoMark from './ui/LogoMark.astro';
import { globalConstants } from '$util/globalConstants';

/**
 * Sticky site header: the mark and name on the left, primary nav on the
 * right. The current section gets a rust underline.
 */
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const links = [
  { href: '/courses', label: 'Courses' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' }
];
const isCurrent = (href: string): boolean => pathname === href || pathname.startsWith(`${href}/`);
---

<header
  class="sticky top-0 z-40 border-b border-foreground/10 bg-background/95"
>
  <Container class="flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="group/home flex items-center gap-3 font-display text-sm font-bold uppercase tracking-[0.2em] text-foreground"
    >
      <LogoMark id="header-mark" class="h-9 w-auto" />
      <span class="hidden transition-colors duration-(--duration-snap) ease-soft group-hover/home:text-primary sm:inline">
        {globalConstants.siteName}
      </span>
      <span class="sr-only sm:hidden">{globalConstants.siteName}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class="relative block px-3 py-2 font-display text-xs font-bold uppercase tracking-[0.18em] text-foreground/75 transition-colors duration-(--duration-snap) ease-soft after:absolute after:inset-x-3 after:bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-(--duration-glide) after:ease-soft hover:text-foreground hover:after:scale-x-100 aria-[current=page]:text-foreground aria-[current=page]:after:scale-x-100"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>
