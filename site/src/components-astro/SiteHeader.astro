---
import { Image } from 'astro:assets';
import logoMark from '../assets/logo-gold.svg';
import logoFull from '../assets/logo-full-text-gold.svg';
import Container from '$components-astro/ui/Container.astro';

/** Primary navigation, in reading order. */
const links = [
  { href: '/courses', label: 'Courses' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' }
];

// `build.format: 'file'` serves `/courses.html` at `/courses`; compare on the bare path.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string): boolean => path === href || path.startsWith(`${href}/`);
---

<header class="relative z-20 border-b border-foreground/10 bg-background/95 bg-ruler">
  <Container class="flex h-18 items-center justify-between gap-6">
    <a
      href="/"
      class="flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <Image src={logoMark} alt="Ignition Intel" class="h-9 w-auto sm:hidden" loading="eager" />
      <Image
        src={logoFull}
        alt="Ignition Intel"
        class="hidden h-8 w-auto sm:block"
        loading="eager"
      />
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-5 sm:gap-8">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class:list={[
                  'relative block py-2 font-display text-xs font-bold tracking-[0.2em] uppercase transition-colors duration-(--duration-snap) ease-soft',
                  'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:bg-accent after:transition-transform after:duration-(--duration-glide) after:ease-soft',
                  isCurrent(href)
                    ? 'text-foreground after:scale-x-100'
                    : 'text-foreground/70 after:scale-x-0 hover:text-foreground hover:after:scale-x-100'
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>
