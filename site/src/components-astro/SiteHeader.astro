---
import { Image } from 'astro:assets';
import logoFull from '../assets/logo-full-text-gold.svg';
import logoMark from '../assets/logo-gold.svg';
import Container from './ui/Container.astro';

/**
 * Site-wide header: a thin field-notes strip above a sticky bar with the logo
 * and the main navigation. The current page gets a rust underline.
 */
const links = [
  { href: '/courses', label: 'Courses' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' }
];

// Built pages report `/about.html`; dev reports `/about`. Compare on the
// extensionless, slashless form.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string): boolean => path === href || path.startsWith(`${href}/`);
---

<div class="border-b border-foreground/10 bg-muted">
  <Container
    class="flex h-8 items-center justify-between font-display text-[0.65rem] font-bold uppercase tracking-[0.22em] text-foreground/55"
  >
    <span>Fire &amp; arson investigation training</span>
    <span class="hidden sm:inline">Nicole Brewer, DFS &middot; Molalla, Oregon</span>
  </Container>
</div>
<header class="sticky top-0 z-40 border-b border-foreground/10 bg-background">
  <Container class="flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
    >
      <Image src={logoFull} alt="Ignition Intel" class="hidden h-7 w-auto sm:block" loading="eager" />
      <Image src={logoMark} alt="Ignition Intel" class="h-9 w-auto sm:hidden" loading="eager" />
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-5 sm:gap-9">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class="relative block py-2 font-display text-xs font-bold uppercase tracking-[0.16em] text-foreground/75 transition-colors duration-(--duration-snap) ease-soft after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-(--duration-glide) after:ease-soft hover:text-foreground hover:after:scale-x-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary aria-[current=page]:text-foreground aria-[current=page]:after:scale-x-100 sm:text-sm"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>
