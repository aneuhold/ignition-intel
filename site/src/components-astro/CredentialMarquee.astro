---
import { MotionEffect } from '$util/motion/MotionEffect';

/**
 * A rust band of the standards Nicole teaches to and the credentials she holds, looping
 * sideways while it is on screen. Without motion it is a static row.
 */
const items = [
  'NFPA 921',
  'NFPA 1033',
  'NFPA 1321',
  'IAAI-CFI(V)',
  'IAAI-ECT',
  'NAFI-CFEI',
  'NAFI-CFII',
  'DFS',
  '3,500+ investigations',
  '30 years fire service'
];
---

<div
  class="overflow-hidden border-y-4 border-primary-foreground/30 bg-accent py-5 lg:py-7"
  data-motion={MotionEffect.Marquee}
>
  <p class="sr-only">Standards and credentials: {items.join(', ')}.</p>
  <div data-marquee-track class="flex w-max" aria-hidden="true">
    {
      [0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {items.map((item) => (
            <li class="flex items-center font-display text-2xl font-black tracking-tight whitespace-nowrap text-accent-foreground uppercase lg:text-5xl">
              <span class="px-6 lg:px-10">{item}</span>
              <span class="h-3 w-4 bg-primary clip-v lg:h-5 lg:w-7" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
