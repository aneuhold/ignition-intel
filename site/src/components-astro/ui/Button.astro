---
/**
 * Link styled as a button. `primary` is the gold transactional action;
 * `outline` is the secondary action beside it; `ink` is the primary action
 * when the button sits on paper (`PaperCard`), where gold has too little
 * contrast.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'ink';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
const variantClasses = {
  primary: 'bg-primary text-primary-foreground hover:bg-primary/85',
  outline: 'border border-foreground/30 text-foreground hover:border-primary hover:text-primary',
  ink: 'bg-primary-foreground text-foreground hover:bg-primary-foreground/85'
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center gap-2 px-5 py-3 font-display text-sm font-bold uppercase tracking-[0.14em] transition-colors duration-(--duration-snap) ease-soft focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary',
    variantClasses[variant],
    className
  ]}
>
  <slot />
  <span
    aria-hidden="true"
    class="transition-transform duration-(--duration-snap) ease-soft group-hover:translate-x-0.5">&rarr;</span
  >
</a>
