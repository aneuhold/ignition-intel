---
/**
 * A link styled as a button, with an arrow that nudges forward on hover.
 * `primary` is the gold fill for the page's main action; `secondary` is a
 * hairline outline for the action beside it.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center gap-3 rounded-sm px-5 py-3.5 font-display text-xs font-semibold tracking-[0.08em] uppercase sm:px-6 sm:text-sm sm:tracking-[0.12em] transition-colors duration-(--duration-snap) ease-soft focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary',
    variant === 'primary'
      ? 'bg-primary text-primary-foreground hover:bg-primary/90'
      : 'border border-foreground/25 text-foreground hover:border-foreground/60',
    className
  ]}
>
  <slot />
  <span
    aria-hidden="true"
    class="transition-transform duration-(--duration-glide) ease-soft group-hover:translate-x-1"
  >
    &rarr;
  </span>
</a>
