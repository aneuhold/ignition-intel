---
/**
 * Typesetting for rendered markdown, in the document style: `##` headings
 * become numbered section labels (1.0, 2.0), `###` headings number beneath
 * them (2.1, 2.2), and lists become ruled lines. Wrap a `<Content />` in it.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const typesetting = [
  'max-w-[38rem] text-lg leading-relaxed text-foreground/85 [counter-reset:prose-h2]',
  // Section labels, numbered.
  '[&_h2]:mt-16 [&_h2]:mb-6 [&_h2]:scroll-mt-10 [&_h2]:flex [&_h2]:items-baseline [&_h2]:gap-4 [&_h2]:border-t [&_h2]:border-foreground/15 [&_h2]:pt-6',
  '[&_h2]:font-display [&_h2]:text-xs [&_h2]:font-bold [&_h2]:tracking-[0.2em] [&_h2]:text-foreground/80 [&_h2]:uppercase',
  "[&_h2]:[counter-increment:prose-h2] [&_h2]:[counter-reset:prose-h3] [&_h2]:before:text-sm [&_h2]:before:tracking-normal [&_h2]:before:text-primary [&_h2]:before:tabular-nums [&_h2]:before:content-[counter(prose-h2)_'.0']",
  '[&>h2:first-child]:mt-0',
  // Subsections, numbered beneath their section.
  '[&_h3]:mt-10 [&_h3]:mb-3 [&_h3]:flex [&_h3]:items-baseline [&_h3]:gap-3 [&_h3]:font-display [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-foreground',
  "[&_h3]:[counter-increment:prose-h3] [&_h3]:before:text-sm [&_h3]:before:font-semibold [&_h3]:before:text-primary [&_h3]:before:tabular-nums [&_h3]:before:content-[counter(prose-h2)_'.'_counter(prose-h3)]",
  // Body copy.
  '[&_p]:mb-5 [&_p]:text-pretty [&_strong]:font-semibold [&_strong]:text-foreground [&_em]:italic',
  // Lists as ruled lines.
  '[&_ul]:mb-6 [&_ul]:border-t [&_ul]:border-foreground/10 [&_li]:border-b [&_li]:border-foreground/10 [&_li]:py-2.5 [&_li]:text-base [&_li]:leading-snug',
  '[&_ol]:mb-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol_li]:pl-2',
  // Links.
  '[&_a]:text-primary [&_a]:underline [&_a]:decoration-primary/40 [&_a]:underline-offset-4 [&_a]:transition-colors [&_a]:duration-(--duration-snap) [&_a:hover]:decoration-primary'
];
---

<div class:list={[typesetting, className]}>
  <slot />
</div>
