---
/**
 * Long-form styles for rendered markdown: headings in Public Sans, body in
 * Lora, lists with rust markers.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    'max-w-prose text-lg leading-relaxed text-foreground/90',
    '[&_p]:mt-5 [&>*:first-child]:mt-0',
    '[&_h2]:mt-12 [&_h2]:border-t [&_h2]:border-foreground/15 [&_h2]:pt-6 [&_h2]:font-display [&_h2]:text-xs [&_h2]:font-bold [&_h2]:uppercase [&_h2]:tracking-[0.22em] [&_h2]:text-primary',
    '[&_h3]:mt-8 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-bold',
    '[&_ul]:mt-5 [&_ul]:space-y-2 [&_ul]:pl-5 [&_ul]:list-[square] [&_li]:pl-1 [&_li]:marker:text-accent',
    '[&_ol]:mt-5 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5',
    '[&_a]:text-primary [&_a]:underline [&_a]:decoration-primary/40 [&_a]:underline-offset-4 [&_a:hover]:decoration-primary',
    '[&_strong]:font-semibold [&_strong]:text-foreground',
    className
  ]}
>
  <slot />
</div>
