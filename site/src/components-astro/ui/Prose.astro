---
/**
 * Styles rendered markdown: Lora body copy, heavy uppercase subheads, and small V-shaped
 * bullets.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    'font-body text-lg leading-relaxed text-foreground/85',
    '[&_p]:mb-6 [&_strong]:text-foreground [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-4',
    '[&_h2]:mt-16 [&_h2]:mb-6 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-black [&_h2]:tracking-tight [&_h2]:text-foreground [&_h2]:uppercase [&_h2:first-child]:mt-0 lg:[&_h2]:text-3xl',
    '[&_ul]:mb-6 [&_ul]:space-y-3 [&_li]:relative [&_li]:pl-8',
    '[&_li]:before:absolute [&_li]:before:top-[0.55em] [&_li]:before:left-0 [&_li]:before:h-3 [&_li]:before:w-4 [&_li]:before:bg-accent [&_li]:before:clip-v',
    className
  ]}
>
  <slot />
</div>
