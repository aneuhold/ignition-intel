---
/**
 * Typography for rendered markdown bodies.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    'font-body text-lg leading-relaxed text-foreground/85',
    '[&_p]:mb-6 [&_a]:text-primary [&_a]:underline [&_a]:decoration-accent [&_a]:underline-offset-4',
    '[&_h2]:mt-14 [&_h2]:mb-5 [&_h2]:font-display [&_h2]:text-xs [&_h2]:font-bold [&_h2]:uppercase [&_h2]:tracking-[0.24em] [&_h2]:text-primary',
    '[&_h3]:mt-10 [&_h3]:mb-3 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-foreground',
    '[&_ul]:mb-6 [&_ul]:grid [&_ul]:gap-3 [&_li]:relative [&_li]:pl-6',
    '[&_li]:before:absolute [&_li]:before:top-[0.7em] [&_li]:before:left-0 [&_li]:before:h-0.5 [&_li]:before:w-3 [&_li]:before:bg-accent',
    '[&_strong]:font-semibold [&_strong]:text-foreground',
    className
  ]}
>
  <slot />
</div>
