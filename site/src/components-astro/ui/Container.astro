---
/**
 * Horizontal page container: centered, max width, side padding. Every section's content
 * sits inside one so edges line up down the page.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['mx-auto w-full max-w-6xl px-5 sm:px-8', className]}>
  <slot />
</div>
