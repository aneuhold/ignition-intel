---
/**
 * Centers content at the site's max width with the standard side gutters.
 */
interface Props {
  /** `narrow` caps the width for reading-length text. */
  width?: 'default' | 'narrow';
  class?: string;
}

const { width = 'default', class: className } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full px-5 sm:px-8',
    width === 'narrow' ? 'max-w-3xl' : 'max-w-6xl',
    className
  ]}
>
  <slot />
</div>
