---
/**
 * Centered max-width wrapper with the site's horizontal gutters.
 */
interface Props {
  class?: string;
  /** Narrower measure for long-form reading. */
  narrow?: boolean;
}

const { class: className, narrow = false } = Astro.props;
---

<div class:list={['mx-auto w-full px-5 sm:px-8', narrow ? 'max-w-3xl' : 'max-w-6xl', className]}>
  <slot />
</div>
