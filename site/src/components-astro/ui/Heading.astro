---
/**
 * Display heading in Public Sans. `level` sets the element, `size` sets the
 * scale, so document outline and visual weight can differ.
 */
interface Props {
  level?: 1 | 2 | 3;
  size?: 'display' | 'lg' | 'md';
  id?: string;
  class?: string;
}

const { level = 2, size = 'lg', id, class: className } = Astro.props;
const Tag = `h${level}` as const;
const sizeClasses = {
  display: 'text-4xl leading-[1.05] sm:text-6xl',
  lg: 'text-3xl leading-tight sm:text-4xl',
  md: 'text-xl leading-snug'
};
---

<Tag
  id={id}
  class:list={['font-display font-bold tracking-tight text-balance', sizeClasses[size], className]}
>
  <slot />
</Tag>
