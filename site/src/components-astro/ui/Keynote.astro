---
/**
 * Numbered keynote bubble, the circled reference a drawing uses to tie a note to a spot
 * on the plan. Decorative: the related text carries the meaning.
 */
interface Props {
  mark: string | number;
  class?: string;
}

const { mark, class: className } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    'inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-primary font-display text-xs font-bold text-primary tabular-nums',
    className
  ]}
>
  {mark}
</span>
