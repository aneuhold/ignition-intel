---
/**
 * North arrow symbol from a plan drawing. Decorative.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 56"
  aria-hidden="true"
  class:list={['fill-none stroke-primary', className]}
  stroke-width="1"
>
  <circle cx="20" cy="36" r="16" class="stroke-primary/50"></circle>
  <path d="M20 14 L28 46 L20 40 L12 46 Z"></path>
  <path d="M20 14 L20 40 L12 46 Z" class="fill-primary"></path>
  <text
    x="20"
    y="9"
    text-anchor="middle"
    class="fill-primary stroke-none font-display text-[9px] font-bold">N</text
  >
</svg>
