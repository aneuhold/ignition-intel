---
import type { CollectionEntry } from 'astro:content';
import { MotionEffect } from '$util/motion/MotionEffect';
import Button from './ui/Button.astro';
import { ButtonVariant } from './ui/ButtonVariant';
import Container from './ui/Container.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Heading from './ui/Heading.astro';
import { HeadingSize } from './ui/HeadingSize';

/**
 * Every course as a numbered card on one rail, ending with a card that points to the
 * contact page. On desktop the section pins and the rail slides sideways as the page
 * scrolls (or scrolls natively without motion); on smaller screens the cards stack.
 */
interface Props {
  courses: CollectionEntry<'courses'>[];
}

const { courses } = Astro.props;
const cardClasses =
  'group relative flex shrink-0 flex-col gap-6 overflow-hidden p-7 transition-colors duration-(--duration-glide) ease-soft focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-primary lg:w-[30rem] lg:snap-start lg:p-10';
---

<section
  id="courses"
  data-motion={MotionEffect.CourseRail}
  class="relative scroll-mt-20 bg-background py-20 lg:flex lg:h-svh lg:flex-col lg:justify-center lg:gap-10 lg:pt-28 lg:pb-12"
>
  <Container class="mb-10 flex flex-col gap-6 lg:mb-0 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <Eyebrow class="mb-4">Courses</Eyebrow>
      <Heading level={2} size={HeadingSize.Display}>What I Teach.</Heading>
    </div>
    <Button href="/courses" variant={ButtonVariant.Outline} class="self-start lg:self-auto">
      All courses
    </Button>
  </Container>

  <div data-rail-viewport class="lg:min-h-0 lg:flex-1 lg:snap-x lg:snap-mandatory lg:overflow-x-auto">
    <ul
      data-rail-track
      class="flex flex-col gap-5 px-5 sm:px-8 lg:h-full lg:w-max lg:flex-row lg:gap-6 lg:px-12"
    >
      {
        courses.map((course, index) => (
          <li class="lg:h-full">
            <a
              href={`/courses/${course.id}`}
              data-rail-card
              class:list={[cardClasses, 'h-full bg-muted hover:bg-muted/60']}
            >
              <span
                aria-hidden="true"
                class="absolute top-0 left-1/2 h-16 w-28 -translate-x-1/2 origin-top scale-y-50 bg-linear-to-b from-accent to-primary transition-transform duration-(--duration-glide) ease-soft clip-v group-hover:scale-y-100"
              />
              <span class="font-display text-display font-black text-foreground/15 transition-colors duration-(--duration-glide) ease-soft group-hover:text-primary">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="font-display text-title font-bold text-balance">{course.data.title}</h3>
              <p class="text-foreground/75">{course.data.description}</p>
              <span class="mt-auto font-display text-sm font-bold tracking-[0.16em] text-primary uppercase">
                Course details{' '}
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform duration-(--duration-snap) ease-soft group-hover:translate-x-1"
                >
                  &rarr;
                </span>
              </span>
            </a>
          </li>
        ))
      }
      <li class="lg:h-full">
        <a
          href="/contact"
          data-rail-card
          class:list={[cardClasses, 'h-full justify-end bg-primary text-primary-foreground hover:bg-primary/90']}
        >
          <span class="font-display text-title font-black uppercase lg:text-5xl">Not Sure Where to Start?</span>
          <p class="text-lg">
            Tell me where you are and what your agency needs. I'll point you to the right course.
          </p>
          <span class="font-display text-sm font-bold tracking-[0.16em] uppercase">
            Ask me{' '}
            <span
              aria-hidden="true"
              class="inline-block transition-transform duration-(--duration-snap) ease-soft group-hover:translate-x-1"
            >
              &rarr;
            </span>
          </span>
        </a>
      </li>
    </ul>
  </div>

  <Container class="hidden lg:block">
    <div class="h-1 bg-foreground/10">
      <div data-rail-progress class="h-full origin-left bg-linear-to-r from-accent to-primary"></div>
    </div>
  </Container>
</section>
