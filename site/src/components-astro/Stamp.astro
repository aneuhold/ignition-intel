---
/**
 * A rubber-stamp mark in rust ink: a double border, wide-tracked capitals, and
 * a fixed tilt. Gaps in the ink come from a static scatter of paper-colored
 * specks drawn over it (no live SVG filter, so it stays cheap to paint and to
 * animate). Carries `data-motion="stamp"` so it lands with a thunk when
 * scrolled into view; place it inside an element marked
 * `data-motion="stamp-surface"` for that element to jolt on impact.
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;

// Speck layout in a 300x80 box, from a fixed-seed generator so every build
// draws the same stamp.
const speckCount = 420;
let seed = 7;
const random = (): number => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};
const specks = Array.from({ length: speckCount }, () => ({
  x: (random() * 300).toFixed(1),
  y: (random() * 80).toFixed(1),
  // Mostly fine grain, with the occasional larger skip in the ink.
  r: (random() < 0.88 ? 0.5 + random() * 1.1 : 1.8 + random() * 2).toFixed(2)
}));
---

<span data-motion="stamp" class:list={['pointer-events-none inline-block select-none', className]}>
  <span
    class="relative block rotate-[-9deg] rounded-sm border-[3px] border-accent px-4 py-1.5 font-display text-2xl font-bold uppercase tracking-[0.16em] text-accent outline-[1.5px] outline-offset-[3px] outline-accent sm:text-3xl"
  >
    {label}
    <svg
      aria-hidden="true"
      viewBox="0 0 300 80"
      preserveAspectRatio="xMidYMid slice"
      class="absolute -inset-2 h-[calc(100%+1rem)] w-[calc(100%+1rem)] text-foreground"
    >
      {specks.map(({ x, y, r }) => <circle cx={x} cy={y} r={r} fill="currentColor" />)}
    </svg>
  </span>
</span>
