---
import RoomPlan from './RoomPlan.astro';

/**
 * Line-drawn floor plan of a living room and kitchen with the area of origin marked.
 * Keynote 1 points at the area of origin and keynote 2 at the entry door; the hero copy
 * carries matching keynotes. Each `data-draw-step` group draws in order on load. Keynote
 * labels are too small to read on narrow screens, so they hide there and the page shows
 * a keynote legend instead.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const dim = 'stroke-primary/70';
const dimText = 'fill-primary font-display text-[11px] font-bold tracking-[0.12em]';
const roomText = 'fill-foreground/45 font-display text-[10px] font-bold tracking-[0.24em]';
---

<svg
  viewBox="0 0 640 500"
  role="img"
  aria-labelledby="hero-plan-title"
  data-draw
  class:list={['h-auto w-full fill-none overflow-visible', className]}
  stroke-width="1.25"
  stroke-linecap="square"
>
  <title id="hero-plan-title">
    Floor plan of a living room and kitchen with the area of origin marked beside the sofa.
  </title>

  <RoomPlan />

  <g data-draw-step>
    <!-- Overall dimensions with extension lines. -->
    <path class={dim} d="M60 52 V24 M580 52 V24 M60 34 H580"></path>
    <path class={dim} d="M56 38 L64 30 M576 38 L584 30"></path>
    <path class={dim} d="M52 60 H22 M52 420 H22 M32 60 V420"></path>
    <path class={dim} d="M28 64 L36 56 M28 424 L36 416"></path>
    <text x="320" y="28" text-anchor="middle" class={dimText}>26'-0"</text>
    <text
      x="24"
      y="240"
      text-anchor="middle"
      transform="rotate(-90 24 240)"
      class={dimText}>18'-0"</text
    >
    <text x="225" y="160" text-anchor="middle" class={roomText}>LIVING RM</text>
    <text x="470" y="160" text-anchor="middle" class={roomText}>KITCHEN</text>
  </g>

  <g data-draw-step>
    <!-- Area of origin. -->
    <ellipse
      data-draw-fade
      cx="104"
      cy="348"
      rx="44"
      ry="38"
      class="fill-accent/35 stroke-none"></ellipse>
    <ellipse
      cx="104"
      cy="348"
      rx="44"
      ry="38"
      class="stroke-accent"
      stroke-width="1.75"
      stroke-dasharray="6 4"></ellipse>
    <!-- Keynote 1: leader from the origin to its bubble. -->
    <path class="stroke-primary" d="M136 322 L196 262 H232"></path>
    <circle data-draw-fade cx="104" cy="348" r="3" class="fill-primary stroke-none"></circle>
    <g data-draw-fade>
      <circle cx="248" cy="262" r="16" class="fill-background stroke-primary"></circle>
      <text
        x="248"
        y="266.5"
        text-anchor="middle"
        class="fill-primary font-display text-[13px] font-bold">1</text
      >
    </g>
    <text x="270" y="258" class="fill-foreground font-display text-[11px] font-bold tracking-[0.16em] max-sm:hidden"
      >AREA OF ORIGIN</text
    >
    <text x="270" y="273" class="fill-foreground/60 font-body text-[11px] italic max-sm:hidden"
      >fire patterns + arc mapping</text
    >
    <!-- Keynote 2: leader from the doorway to its bubble. -->
    <path class="stroke-primary" d="M170 404 L214 460 H288"></path>
    <g data-draw-fade>
      <circle cx="304" cy="460" r="16" class="fill-background stroke-primary"></circle>
      <text
        x="304"
        y="464.5"
        text-anchor="middle"
        class="fill-primary font-display text-[13px] font-bold">2</text
      >
    </g>
    <text x="326" y="456" class="fill-foreground font-display text-[11px] font-bold tracking-[0.16em] max-sm:hidden"
      >ENTRY</text
    >
    <text x="326" y="471" class="fill-foreground/60 font-body text-[11px] italic max-sm:hidden"
      >every scene starts at the door</text
    >
  </g>
</svg>
