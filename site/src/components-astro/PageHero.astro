---
import Container from './ui/Container.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Heading from './ui/Heading.astro';
import { HeadingSize } from './ui/HeadingSize';

/**
 * The opening block of an inner page: eyebrow, one poster or display headline, an optional
 * lede, and an optional right-hand column (a graphic or a photo frame) from the `aside` slot.
 */
interface Props {
  eyebrow: string;
  heading: string;
  lede?: string;
  /** Long headlines (course titles) step down from poster to display size. */
  size?: HeadingSize;
}

const { eyebrow, heading, lede, size = HeadingSize.Poster } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="relative overflow-hidden">
  <Container
    class:list={[
      'grid gap-12 pt-14 pb-20 lg:gap-16 lg:pt-24 lg:pb-28',
      hasAside && 'lg:grid-cols-[3fr_2fr] lg:items-end'
    ]}
  >
    <div class="flex flex-col gap-8">
      <slot name="before" />
      <Eyebrow>{eyebrow}</Eyebrow>
      <Heading level={1} size={size}>{heading}</Heading>
      {lede && <p class="max-w-2xl text-lg leading-relaxed text-foreground/85 lg:text-xl">{lede}</p>}
      <slot />
    </div>
    <slot name="aside" />
  </Container>
</section>
