---
import CallToAction from '$components-astro/CallToAction.astro';
import CourseGrid from '$components-astro/CourseGrid.astro';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import Heading from '$components-astro/ui/Heading.astro';
import Section from '$components-astro/ui/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteContentService from '$util/SiteContent.service';

const courses = await siteContentService.courses();
---

<BaseLayout
  title="Fire Investigation Training | Ignition Intel"
  description="Fire and arson investigation courses and training offered by Ignition Intel. Placeholder description: update before launch."
>
  <Section class="pb-12 sm:pb-16">
    <div class="flex max-w-3xl flex-col gap-6">
      <Eyebrow>Courses</Eyebrow>
      <Heading level={1} size="display" reveal="load">Training built on the method, not the hunch.</Heading>
      <p data-reveal class="font-body text-xl leading-relaxed text-foreground/75">
        Every course follows NFPA 921 and maps to the job performance requirements in NFPA 1033.
        I teach in person and online, to individuals and to whole agencies.
      </p>
    </div>
  </Section>
  <Section class="pt-0 sm:pt-0">
    <CourseGrid courses={courses} />
  </Section>
  <CallToAction
    eyebrow="Training for your team"
    heading="Want a course brought to your agency?"
    body="I teach on-site for fire departments, police agencies, and insurance teams. Tell me how many people and what you need, and we'll work out the rest."
    label="Ask about on-site training"
  />
</BaseLayout>
