---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '$components-astro/CtaBand.astro';
import PageHero from '$components-astro/PageHero.astro';
import Button from '$components-astro/ui/Button.astro';
import Container from '$components-astro/ui/Container.astro';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import { HeadingSize } from '$components-astro/ui/HeadingSize';
import Prose from '$components-astro/ui/Prose.astro';
import Section from '$components-astro/ui/Section.astro';
import { SectionTone } from '$components-astro/ui/SectionTone';
import VDivider from '$components-astro/ui/VDivider.astro';
import siteContentService from '$util/SiteContent.service';
import youTubeService from '$util/YouTube.service';

interface Props {
  course: CollectionEntry<'courses'>;
  index: number;
  total: number;
  next: CollectionEntry<'courses'>;
}

/**
 * See docs: https://docs.astro.build/en/reference/routing-reference/#getstaticpaths
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await siteContentService.courses();
  return courses.map((course, index) => ({
    params: { slug: course.id },
    props: {
      course,
      index,
      total: courses.length,
      next: courses[(index + 1) % courses.length]
    }
  }));
};

const { course, index, total, next } = Astro.props;
const { title, description, videoUrl } = course.data;
const { Content } = await render(course);
const contactHref = `/contact?course=${encodeURIComponent(course.id)}`;
const pad = (value: number): string => String(value).padStart(2, '0');
---

<BaseLayout title={`${title} | Ignition Intel`} description={description}>
  <PageHero
    eyebrow={`Course ${pad(index + 1)} of ${pad(total)}`}
    heading={title}
    lede={description}
    size={HeadingSize.Display}
  >
    <a
      slot="before"
      href="/courses"
      class="group inline-flex gap-2 self-start font-display text-xs font-bold tracking-[0.2em] text-foreground/60 uppercase transition-colors duration-(--duration-snap) ease-soft hover:text-primary"
    >
      <span
        aria-hidden="true"
        class="inline-block transition-transform duration-(--duration-snap) ease-soft group-hover:-translate-x-1"
        >&larr;</span
      >
      All courses
    </a>
    <Button href={contactHref} class="self-start">Get more info about this course</Button>
  </PageHero>

  <VDivider below={SectionTone.Muted} />
  <Section tone={SectionTone.Muted} class="pt-10 lg:pt-14">
    <div class="border-4 border-foreground/10 bg-background">
      <iframe
        src={youTubeService.convertToEmbedUrl(videoUrl)}
        title={`${title} video`}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
        loading="lazy"
        class="aspect-video w-full"></iframe>
    </div>
    <div class="mt-20 grid gap-16 lg:mt-28 lg:grid-cols-[3fr_2fr] lg:gap-24">
      <Prose>
        <Content />
      </Prose>
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <div class="flex flex-col gap-6 border-t-4 border-accent bg-background p-8 lg:p-10">
          <Eyebrow>Interested?</Eyebrow>
          <p class="font-display text-title font-black uppercase">Ask Me About This Course.</p>
          <p class="text-foreground/80">
            Dates, location, cost, or bringing it to your agency. Send a note and I'll get back to
            you.
          </p>
          <Button href={contactHref} class="self-start">Get more info</Button>
        </div>
      </aside>
    </div>
  </Section>

  {
    next.id !== course.id && (
      <Section>
        <a
          href={`/courses/${next.id}`}
          class="group flex flex-col gap-6 focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-primary"
        >
          <Eyebrow>Next course</Eyebrow>
          <span class="font-display text-display font-black text-balance uppercase transition-colors duration-(--duration-glide) ease-soft group-hover:text-primary">
            {next.data.title}{' '}
            <span
              aria-hidden="true"
              class="inline-block transition-transform duration-(--duration-snap) ease-soft group-hover:translate-x-3"
            >
              &rarr;
            </span>
          </span>
        </a>
      </Section>
    )
  }

  <Container>
    <div class="h-0.5 bg-foreground/15"></div>
  </Container>
  <VDivider />
  <CtaBand
    heading="Get More Info About This Course."
    body={`Tell me a little about you or your agency and I'll send dates, format, and cost for ${title}.`}
    href={contactHref}
    label="Get more info"
  />
</BaseLayout>
