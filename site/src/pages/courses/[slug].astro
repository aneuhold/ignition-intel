---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import CallToAction from '$components-astro/CallToAction.astro';
import CourseGrid from '$components-astro/CourseGrid.astro';
import Button from '$components-astro/ui/Button.astro';
import Container from '$components-astro/ui/Container.astro';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import Heading from '$components-astro/ui/Heading.astro';
import Prose from '$components-astro/ui/Prose.astro';
import Section from '$components-astro/ui/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteContentService from '$util/SiteContent.service';
import youTubeService from '$util/YouTube.service';

interface Props {
  course: CollectionEntry<'courses'>;
  others: CollectionEntry<'courses'>[];
  number: number;
}

/**
 * See docs: https://docs.astro.build/en/reference/routing-reference/#getstaticpaths
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await siteContentService.courses();
  return courses.map((course, index) => ({
    params: { slug: course.id },
    props: {
      course,
      others: courses.filter((other) => other.id !== course.id),
      number: index + 1
    }
  }));
};

const { course, others, number } = Astro.props;
const { title, description, videoUrl } = course.data;
const { Content } = await render(course);
const inquiryHref = `/contact?course=${encodeURIComponent(course.id)}`;
---

<BaseLayout title={`${title} | Ignition Intel`} description={description}>
  <section class="relative isolate overflow-hidden border-b border-foreground/10">
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_80%_at_85%_120%,color-mix(in_oklch,var(--color-accent)_32%,transparent),transparent_70%)]"
    >
    </div>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -right-4 -bottom-16 -z-10 hidden font-display text-[22rem] leading-none font-bold tracking-tighter text-transparent [-webkit-text-stroke:1px_color-mix(in_oklch,var(--color-primary)_35%,transparent)] lg:block"
    >
      {String(number).padStart(2, '0')}
    </span>
    <Container class="flex flex-col gap-7 py-16 sm:py-24">
      <a
        href="/courses"
        class="self-start font-display text-xs font-bold tracking-[0.18em] text-foreground/60 uppercase transition-colors duration-(--duration-snap) ease-soft hover:text-primary"
      >
        &larr; All courses
      </a>
      <Eyebrow>Course {String(number).padStart(2, '0')}</Eyebrow>
      <Heading level={1} size="display" reveal="load" class="max-w-[18ch]">{title}</Heading>
      <p data-reveal class="max-w-2xl font-body text-xl leading-relaxed text-foreground/80">
        {description}
      </p>
      <div data-reveal class="flex flex-wrap items-center gap-4">
        <Button href={inquiryHref} magnetic>Get more info about this course</Button>
        <Button href="#overview" variant="ghost">Watch the overview</Button>
      </div>
    </Container>
  </section>

  <Section>
    <div class="grid gap-14 lg:grid-cols-[1fr_20rem] lg:gap-20">
      <div class="flex min-w-0 flex-col gap-14">
        <div
          id="overview"
          data-reveal
          class="scroll-mt-24 overflow-hidden rounded-2xl border border-foreground/10 bg-muted shadow-[0_2rem_4rem_-2rem_rgb(0_0_0/0.5)]"
        >
          <iframe
            src={youTubeService.convertToEmbedUrl(videoUrl)}
            title={`${title} video`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
            class="aspect-video w-full"></iframe>
        </div>
        <Prose class="[&>p:first-child]:text-xl [&>p:first-child]:text-foreground">
          <Content />
        </Prose>
      </div>
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="flex flex-col gap-5 rounded-2xl border border-primary/30 bg-muted p-7">
          <p class="font-display text-xs font-bold tracking-[0.24em] text-primary uppercase">
            Questions?
          </p>
          <p class="font-body text-base leading-relaxed text-foreground/80">
            Dates, cost, whether it's the right fit for where you are: ask me and I'll give you a
            straight answer.
          </p>
          <Button href={inquiryHref} class="w-full">Get more info</Button>
        </div>
      </aside>
    </div>
  </Section>

  {
    others.length > 0 && (
      <Section tone="muted">
        <div class="mb-10 flex flex-col gap-5">
          <Eyebrow>Other courses</Eyebrow>
          <Heading reveal="scroll">Keep going.</Heading>
        </div>
        <CourseGrid courses={others} />
      </Section>
    )
  }

  <CallToAction
    eyebrow={title}
    heading="Want to know more about this course?"
    body="Send me a note and I'll get back to you with dates, format, and anything else you need to decide."
    href={inquiryHref}
    label="Get more info about this course"
  />
</BaseLayout>
