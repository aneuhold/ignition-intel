---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseTag from '$components-astro/CourseTag.astro';
import Button from '$components-astro/ui/Button.astro';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import Heading from '$components-astro/ui/Heading.astro';
import PaperCard from '$components-astro/ui/PaperCard.astro';
import Prose from '$components-astro/ui/Prose.astro';
import ScenePhoto from '$components-astro/ui/ScenePhoto.astro';
import Section from '$components-astro/ui/Section.astro';
import caseNumberService from '$util/CaseNumber.service';
import siteContentService from '$util/SiteContent.service';
import youTubeService from '$util/YouTube.service';

interface Props {
  course: CollectionEntry<'courses'>;
  index: number;
  others: { course: CollectionEntry<'courses'>; index: number }[];
}

/**
 * See docs: https://docs.astro.build/en/reference/routing-reference/#getstaticpaths
 */
export const getStaticPaths: GetStaticPaths = async () => {
  // How many other courses to suggest below the course details. Declared here
  // because Astro runs getStaticPaths outside the rest of the frontmatter.
  const suggestionCount = 3;
  const courses = await siteContentService.courses();
  const indexed = courses.map((course, index) => ({ course, index }));
  return indexed.map(({ course, index }) => ({
    params: { slug: course.id },
    props: {
      course,
      index,
      others: indexed.filter((entry) => entry.index !== index).slice(0, suggestionCount)
    }
  }));
};

const { course, index, others } = Astro.props;
const { title, description, videoUrl } = course.data;
const { Content } = await render(course);
const caseNumber = caseNumberService.forCourse(course.id, index);
const contactHref = `/contact?course=${encodeURIComponent(course.id)}`;
---

<BaseLayout title={`${title} | Ignition Intel Courses`} description={description}>
  <Section flush="bottom">
    <nav
      aria-label="Breadcrumb"
      data-motion="intro"
      class="font-display text-xs font-bold uppercase tracking-[0.2em] text-foreground/55"
    >
      <a href="/courses" class="text-primary transition-colors duration-(--duration-snap) hover:text-foreground"
        >Courses</a
      >
      <span aria-hidden="true" class="mx-2">/</span>
      <span class="tabular-nums" aria-current="page">No. {caseNumber}</span>
    </nav>
    <div class="mt-6 flex max-w-3xl flex-col gap-5">
      <Heading level={1} size="display">{title}</Heading>
      <p class="text-xl leading-relaxed text-foreground/85 italic">
        {description}
      </p>
    </div>
  </Section>

  <Section flush="top" class="pt-12 sm:pt-16">
    <!-- On narrow screens the course-info card sits between the video and the
         details, so the call to action comes before the long read. -->
    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-x-16">
      <ScenePhoto
        figure={`No. ${caseNumber}`}
        caption="Course overview video"
        aspect="video"
        class="min-w-0 lg:col-start-1 lg:row-start-1"
      >
        <iframe
          src={youTubeService.convertToEmbedUrl(videoUrl)}
          title={`${title} video`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
          class="absolute inset-0 h-full w-full"></iframe>
      </ScenePhoto>
      <aside
        class="lg:sticky lg:top-24 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-start"
        aria-labelledby="course-info-heading"
      >
        <PaperCard ruled class="rotate-[0.6deg] py-7 pr-6">
          <p
            class="font-display text-[0.65rem] font-bold uppercase leading-7 tracking-[0.2em] text-accent"
          >
            Course file &middot; <span class="tabular-nums">{caseNumber}</span>
          </p>
          <Heading level={2} size="md" id="course-info-heading" class="leading-7">
            Get more info about this course
          </Heading>
          <p class="mt-7 leading-7">
            Dates, location, cost, or bringing it to your agency. Send a note and I'll answer it
            myself.
          </p>
          <Button href={contactHref} variant="ink" class="mt-7 w-full">Ask about this course</Button
          >
        </PaperCard>
      </aside>
      <Prose class="min-w-0 lg:col-start-1 lg:row-start-2">
        <Content />
      </Prose>
    </div>
  </Section>

  {
    others.length > 0 && (
      <Section tone="muted" labelledby="other-courses-heading">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="flex flex-col gap-4">
            <Eyebrow>More on file</Eyebrow>
            <Heading id="other-courses-heading">Other courses</Heading>
          </div>
          <a
            href="/courses"
            class="font-display text-sm font-bold uppercase tracking-[0.16em] text-primary underline decoration-primary/40 underline-offset-8 transition-colors duration-(--duration-snap) ease-soft hover:decoration-primary"
          >
            All courses &rarr;
          </a>
        </div>
        <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((other) => (
            <CourseTag course={other.course} index={other.index} />
          ))}
        </div>
      </Section>
    )
  }
</BaseLayout>
