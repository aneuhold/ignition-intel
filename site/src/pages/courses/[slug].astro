---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '$components-astro/PageHeader.astro';
import YouTubeEmbed from '$components-astro/YouTubeEmbed.astro';
import Button from '$components-astro/ui/Button.astro';
import Frame from '$components-astro/ui/Frame.astro';
import Prose from '$components-astro/ui/Prose.astro';
import Section from '$components-astro/ui/Section.astro';
import drawingSheetService from '$util/DrawingSheet.service';
import siteContentService from '$util/SiteContent.service';

interface Props {
  course: CollectionEntry<'courses'>;
  /** Zero-based position in the sorted course list. */
  index: number;
  courses: CollectionEntry<'courses'>[];
}

/**
 * See docs: https://docs.astro.build/en/reference/routing-reference/#getstaticpaths
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const courses = await siteContentService.courses();
  return courses.map((course, index) => ({
    params: { slug: course.id },
    props: { course, index, courses }
  }));
};

const { course, index, courses } = Astro.props;
const { title, description, videoUrl } = course.data;
const { Content } = await render(course);
const sheet = drawingSheetService.course(index, title);
const others = courses
  .map((entry, position) => ({ entry, code: drawingSheetService.courseCode(position) }))
  .filter(({ entry }) => entry.id !== course.id);
const label =
  'block font-display text-[0.65rem] font-bold tracking-[0.22em] text-foreground/60 uppercase';
---

<BaseLayout title={`${title} | Ignition Intel Courses`} description={description} sheet={sheet}>
  <PageHeader code={sheet.code} eyebrow="Course sheet" title={title}>
    <p class="italic">{description}</p>
    <Button href={`/contact?course=${course.id}`} class="mt-8 lg:hidden">
      Get more info about this course
    </Button>
  </PageHeader>

  <Section>
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-8">
        <figure>
          <Frame class="p-2 sm:p-3">
            <YouTubeEmbed url={videoUrl} title={`${title} video`} />
          </Frame>
          <figcaption
            class="mt-4 font-display text-[0.7rem] font-bold tracking-[0.2em] text-foreground/60 uppercase"
          >
            <span class="text-primary">Fig. 1</span>&ensp;Course overview
          </figcaption>
        </figure>
        <Prose class="mt-10">
          <Content />
        </Prose>
      </div>

      <aside class="lg:col-span-4">
        <div class="flex flex-col gap-10 lg:sticky lg:top-8">
          <Frame tone="primary" class="bg-muted">
            <div class="grid grid-cols-[1fr_auto] border-b border-foreground/15">
              <div class="px-5 py-4">
                <span class={label}>Course</span>
                <p class="mt-1 font-display leading-snug font-bold text-foreground">{title}</p>
              </div>
              <div class="border-l border-foreground/15 px-5 py-4">
                <span class={label}>Sheet</span>
                <p class="mt-1 font-display text-xl font-bold text-primary tabular-nums">
                  {sheet.code}
                </p>
              </div>
            </div>
            <div class="border-b border-foreground/15 px-5 py-4">
              <span class={label}>Instructor</span>
              <p class="mt-1 text-foreground/85">Nicole Brewer, DFS, IAAI-CFI(V), CFEI</p>
            </div>
            <div class="px-5 py-6">
              <p class="mb-5 text-foreground/80">
                Dates, location, and group rates depend on your agency. Ask and I'll send the
                details.
              </p>
              <Button href={`/contact?course=${course.id}`} class="w-full justify-between">
                Get more info about this course
              </Button>
            </div>
          </Frame>

          {
            others.length > 0 && (
              <nav aria-label="Other courses">
                <span class={label}>Other sheets</span>
                <ul class="mt-3 border-t border-foreground/15">
                  {others.map(({ entry, code }) => (
                    <li class="border-b border-foreground/15">
                      <a
                        href={`/courses/${entry.id}`}
                        class="group flex items-baseline gap-4 py-3 transition-colors duration-(--duration-snap) ease-soft hover:text-primary"
                      >
                        <span class="font-display text-xs font-bold text-primary tabular-nums">
                          {code}
                        </span>
                        <span class="font-display text-sm font-semibold text-foreground/85 group-hover:text-primary">
                          {entry.data.title}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </aside>
    </div>
  </Section>
</BaseLayout>
