---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '$components-svelte/ContactForm';
import Container from '$components-astro/ui/Container.astro';
import DocumentGrid from '$components-astro/ui/DocumentGrid.astro';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import Lede from '$components-astro/ui/Lede.astro';
import PageHeader from '$components-astro/ui/PageHeader.astro';
import Rule from '$components-astro/ui/Rule.astro';
import siteContentService from '$util/SiteContent.service';

const [{ phone, email, note }, courses] = await Promise.all([
  siteContentService.contact().then((entry) => entry.data),
  siteContentService.courses()
]);
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
const courseOptions = courses.map((course) => ({ slug: course.id, title: course.data.title }));
const contactLinkClass =
  'link-underline self-start font-display text-base font-semibold text-foreground';
---

<BaseLayout
  title="Contact Ignition Intel | Fire Investigation Training"
  description="Get in touch with Ignition Intel about fire and arson investigation courses and training. Send a note through the contact form."
>
  <link slot="head" rel="preconnect" href="https://challenges.cloudflare.com" />
  <PageHeader kicker="Contact" title="Get in touch.">
    <Lede>{note}</Lede>
  </PageHeader>

  <section class="pt-6 pb-14 sm:pt-10 sm:pb-20">
    <Container>
      <Rule />
      <DocumentGrid class="mt-10">
        <address slot="margin" data-reveal class="flex flex-col gap-6 not-italic">
          <div class="flex flex-col gap-2">
            <Eyebrow as="span" tone="muted">Email</Eyebrow>
            <a href={`mailto:${email}`} class={contactLinkClass}>{email}</a>
          </div>
          {
            phone && (
              <div class="flex flex-col gap-2">
                <Eyebrow as="span" tone="muted">Phone</Eyebrow>
                <a href={telHref} class={contactLinkClass}>
                  {phone}
                </a>
              </div>
            )
          }
        </address>
        <div data-reveal class="max-w-[38rem]">
          <ContactForm client:idle courses={courseOptions} />
        </div>
      </DocumentGrid>
    </Container>
  </section>
</BaseLayout>
