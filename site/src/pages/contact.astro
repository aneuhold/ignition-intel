---
import ContactForm from '$components-svelte/ContactForm';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import Heading from '$components-astro/ui/Heading.astro';
import Section from '$components-astro/ui/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContentService from '$util/SiteContent.service';

const { phone, email, note } = (await siteContentService.contact()).data;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
const courses = (await siteContentService.courses()).map(({ id, data }) => ({
  slug: id,
  title: data.title
}));
---

<BaseLayout
  title="Contact Ignition Intel | Fire Investigation Training"
  description="Get in touch with Ignition Intel about fire and arson investigation courses and training. Send a note through the contact form."
>
  <link slot="head" rel="preconnect" href="https://challenges.cloudflare.com" />
  <Section class="relative isolate overflow-hidden">
    <div
      aria-hidden="true"
      class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_50%_60%_at_15%_110%,color-mix(in_oklch,var(--color-accent)_28%,transparent),transparent_70%)]"
    >
    </div>
    <div class="grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div class="flex flex-col gap-7">
        <Eyebrow>Contact</Eyebrow>
        <Heading level={1} size="display" reveal="load">Ask me about a course.</Heading>
        <p data-reveal class="max-w-md font-body text-xl leading-relaxed text-foreground/80">
          {note}
        </p>
        <address
          data-reveal
          class="flex flex-col gap-2 font-body text-lg not-italic text-foreground/80"
        >
          {
            phone && (
              <a href={telHref} class="transition-colors duration-(--duration-snap) ease-soft hover:text-primary">
                {phone}
              </a>
            )
          }
          <a
            href={`mailto:${email}`}
            class="self-start text-primary underline decoration-accent underline-offset-4"
          >
            {email}
          </a>
        </address>
      </div>
      <div
        data-reveal
        class="rounded-2xl border border-foreground/10 bg-muted p-6 shadow-[0_2rem_4rem_-2rem_rgb(0_0_0/0.5)] sm:p-9"
      >
        <ContactForm client:idle courses={courses} />
      </div>
    </div>
  </Section>
</BaseLayout>
