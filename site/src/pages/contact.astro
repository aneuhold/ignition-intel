---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '$components-astro/PageHeader.astro';
import Frame from '$components-astro/ui/Frame.astro';
import Section from '$components-astro/ui/Section.astro';
import ContactForm from '$components-svelte/ContactForm';
import siteContentService from '$util/SiteContent.service';

const { phone, email, note } = (await siteContentService.contact()).data;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
const courseTitles = Object.fromEntries(
  (await siteContentService.courses()).map((course) => [course.id, course.data.title])
);
const label =
  'block font-display text-[0.65rem] font-bold tracking-[0.22em] text-foreground/60 uppercase';
const link =
  'font-display font-semibold text-primary underline decoration-primary/40 underline-offset-4 transition-colors duration-(--duration-snap) ease-soft hover:decoration-primary';
---

<BaseLayout
  title="Contact Ignition Intel | Fire Investigation Training"
  description="Get in touch with Ignition Intel about fire and arson investigation courses and training. Send a note through the contact form."
  sheet={{ code: 'D-01', name: 'Contact' }}
>
  <link slot="head" rel="preconnect" href="https://challenges.cloudflare.com" />
  <PageHeader code="D-01" eyebrow="Contact" title="Get in touch.">
    <p>{note}</p>
  </PageHeader>

  <Section>
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-12">
      <Frame tone="primary" class="bg-muted p-6 sm:p-10 lg:col-span-7">
        <ContactForm client:idle courseTitles={courseTitles} />
      </Frame>
      <aside class="lg:col-span-4 lg:col-start-9">
        <span class={label}>Write directly</span>
        <address class="mt-3 flex flex-col gap-2 border-t border-foreground/15 pt-4 not-italic">
          {phone && <a href={telHref} class={link}>{phone}</a>}
          <a href={`mailto:${email}`} class={link}>{email}</a>
        </address>
        <span class:list={[label, 'mt-12']}>What helps me answer</span>
        <ul
          class="mt-3 space-y-3 border-t border-foreground/15 pt-4 text-foreground/80 [&>li]:relative [&>li]:pl-6 [&>li]:before:absolute [&>li]:before:top-[0.6em] [&>li]:before:left-0 [&>li]:before:size-1.5 [&>li]:before:bg-primary [&>li]:before:content-['']"
        >
          <li>What you work now: public, private, or still learning.</li>
          <li>Which course, or what you're trying to get better at.</li>
          <li>For a group: roughly how many people, and where.</li>
        </ul>
      </aside>
    </div>
  </Section>
</BaseLayout>
