---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteInfo from '$components-astro/SiteInfo.astro';
import Container from '$components-astro/ui/Container.astro';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import Heading from '$components-astro/ui/Heading.astro';
import Section from '$components-astro/ui/Section.astro';
import ContactForm from '$components-svelte/ContactForm';
import siteContentService from '$util/SiteContent.service';

const { note } = (await siteContentService.contact()).data;
---

<BaseLayout
  title="Contact Ignition Intel | Fire Investigation Training"
  description="Get in touch with Ignition Intel about fire and arson investigation courses and training. Send a note through the contact form."
>
  <link slot="head" rel="preconnect" href="https://challenges.cloudflare.com" />
  <main>
    <Section padding="tight" background="inverse">
      <Container size="wide">
        <Heading level={1}>Get in touch.</Heading>
        <p class="mt-4 max-w-prose font-display text-lg text-background/80 md:text-xl">
          We'll get back to you as soon as we can.
        </p>
      </Container>
    </Section>

    <Section>
      <Container size="wide">
        <div class="grid gap-10 md:grid-cols-[1fr_1.2fr] md:gap-16">
          <aside class="rounded-lg border border-foreground/10 bg-foreground/5 p-6 md:p-8">
            <Eyebrow as="h2" class="text-foreground/60">
              Reach us
            </Eyebrow>
            <div class="mt-4">
              <SiteInfo />
            </div>
          </aside>

          <div>
            <Eyebrow as="h2" class="text-foreground/60">
              Send a note
            </Eyebrow>
            <p class="mt-4 max-w-prose text-foreground/80">{note}</p>
            <div class="mt-6">
              <ContactForm client:idle />
            </div>
          </div>
        </div>
      </Container>
    </Section>
  </main>
</BaseLayout>
