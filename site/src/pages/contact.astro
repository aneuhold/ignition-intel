---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '$components-astro/PageHero.astro';
import ContactForm from '$components-svelte/ContactForm';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import Section from '$components-astro/ui/Section.astro';
import { SectionTone } from '$components-astro/ui/SectionTone';
import VDivider from '$components-astro/ui/VDivider.astro';
import siteContentService from '$util/SiteContent.service';

const { phone, email, note } = (await siteContentService.contact()).data;
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
const courses = (await siteContentService.courses()).map((course) => ({
  slug: course.id,
  title: course.data.title
}));
---

<BaseLayout
  title="Contact Ignition Intel | Fire Investigation Training"
  description="Get in touch with Ignition Intel about fire and arson investigation courses and training. Send a note through the contact form."
>
  <link slot="head" rel="preconnect" href="https://challenges.cloudflare.com" />
  <PageHero eyebrow="Contact" heading="Send a Note." lede={note} />

  <VDivider below={SectionTone.Muted} />
  <Section tone={SectionTone.Muted} class="pt-10 lg:pt-14">
    <div class="grid gap-16 lg:grid-cols-[2fr_3fr] lg:gap-24">
      <aside class="flex flex-col gap-8">
        <div>
          <Eyebrow class="mb-4">Or reach me directly</Eyebrow>
          <address class="flex flex-col gap-2 font-display text-xl font-bold not-italic">
            {
              phone && (
                <a href={telHref} class="transition-colors duration-(--duration-snap) ease-soft hover:text-primary">
                  {phone}
                </a>
              )
            }
            <a href={`mailto:${email}`} class="break-all transition-colors duration-(--duration-snap) ease-soft hover:text-primary">
              {email}
            </a>
          </address>
        </div>
        <p class="max-w-sm text-foreground/75">
          Asking about a specific course? Start from its page and the form fills in which one.
        </p>
      </aside>
      <div class="border-t-4 border-accent bg-background p-6 sm:p-10">
        <ContactForm client:idle courses={courses} />
      </div>
    </div>
  </Section>
</BaseLayout>
