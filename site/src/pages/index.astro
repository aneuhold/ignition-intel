---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseRail from '$components-astro/CourseRail.astro';
import CredentialMarquee from '$components-astro/CredentialMarquee.astro';
import CtaBand from '$components-astro/CtaBand.astro';
import Principles from '$components-astro/Principles.astro';
import StatsBand from '$components-astro/StatsBand.astro';
import Button from '$components-astro/ui/Button.astro';
import { ButtonVariant } from '$components-astro/ui/ButtonVariant';
import Container from '$components-astro/ui/Container.astro';
import Eyebrow from '$components-astro/ui/Eyebrow.astro';
import Heading from '$components-astro/ui/Heading.astro';
import { HeadingSize } from '$components-astro/ui/HeadingSize';
import Section from '$components-astro/ui/Section.astro';
import { SectionTone } from '$components-astro/ui/SectionTone';
import VDivider from '$components-astro/ui/VDivider.astro';
import VPattern from '$components-astro/ui/VPattern.astro';
import { globalConstants } from '$util/globalConstants';
import siteContentService from '$util/SiteContent.service';

const { title, tagline, heroImage, heroImageAlt = '' } = (await siteContentService.home()).data;
const courses = await siteContentService.courses();
---

<BaseLayout
  title={`${globalConstants.siteName} | Fire & Arson Investigation Training`}
  description="Fire and arson investigation courses taught by Nicole Brewer: origin and cause, NFPA 921 and the scientific method, cognitive bias, documentation, and testimony."
>
  <section class="relative overflow-hidden">
    {
      heroImage && (
        <Image
          src={heroImage}
          alt={heroImageAlt}
          inferSize
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover opacity-20"
        />
      )
    }
    <Container
      class="relative grid min-h-[calc(100svh-4rem)] gap-12 pt-14 pb-24 lg:min-h-[calc(100svh-5rem)] lg:grid-cols-[3fr_2fr] lg:items-center lg:gap-8 lg:pt-10 lg:pb-28"
    >
      <div class="flex flex-col gap-8 lg:gap-10">
        <Eyebrow>{globalConstants.siteName} &middot; Fire &amp; arson investigation training</Eyebrow>
        <Heading level={1} size={HeadingSize.Poster}>{title}</Heading>
        {tagline && <p class="max-w-2xl text-lg leading-relaxed text-foreground/85 lg:text-xl">{tagline}</p>}
        <div class="flex flex-wrap gap-4">
          <Button href="#courses">See the courses</Button>
          <Button href="/contact" variant={ButtonVariant.Outline}>Ask me a question</Button>
        </div>
      </div>
      <VPattern
        class="h-[22rem] sm:h-[28rem] lg:h-[min(40rem,70svh)]"
        caption="Fig. 1. V-pattern. The apex points back toward the area of origin."
      />
    </Container>
  </section>

  <CredentialMarquee />

  <CourseRail courses={courses} />

  <VDivider below={SectionTone.Muted} />
  <Section tone={SectionTone.Muted} class="pt-12 lg:pt-16">
    <Principles />
  </Section>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[2fr_3fr] lg:gap-20">
      <div class="flex flex-col gap-8">
        <Eyebrow>Your instructor</Eyebrow>
        <Heading level={2} size={HeadingSize.Display}>Thirty Years of Scenes.</Heading>
        <p class="text-lg leading-relaxed text-foreground/85">
          I'm {globalConstants.ownerName}. I investigate fires as a Principal Consultant at Envista
          Forensics, and I've been teaching investigators since my years as a fire training
          specialist at Portland Fire &amp; Rescue. These courses come straight out of that work.
        </p>
        <Button href="/about" variant={ButtonVariant.Outline} class="self-start">More about me</Button>
      </div>
      <StatsBand />
    </div>
  </Section>

  <VDivider />
  <CtaBand
    heading="Ask Me About a Course."
    body="Dates, format, cost, or training for your whole agency. Send a note and I'll get back to you."
    href="/contact"
    label="Send a note"
  />
</BaseLayout>
