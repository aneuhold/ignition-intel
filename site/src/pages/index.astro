---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteContentService from '$util/SiteContent.service';

const { title, tagline, heroImage, heroImageAlt = '' } = (await siteContentService.home()).data;
---

<BaseLayout
  title={`${title} | Fire & Arson Investigation Training`}
  description="Ignition Intel offers fire and arson investigation courses and training, taught by Nicole Brewer. Placeholder description: update before launch."
>
  <main>
    {heroImage && (
      <Image src={heroImage} alt={heroImageAlt} inferSize loading="eager" fetchpriority="high" />
    )}
    <h1>{title}</h1>
    {tagline && <p>{tagline}</p>}
  </main>
</BaseLayout>
