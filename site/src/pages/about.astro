---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '$components-astro/About.astro';
import Container from '$components-astro/ui/Container.astro';
import Heading from '$components-astro/ui/Heading.astro';
import Section from '$components-astro/ui/Section.astro';
import siteContentService from '$util/SiteContent.service';

const { heading } = (await siteContentService.about()).data;
---

<BaseLayout
  title="About Nicole Brewer | Ignition Intel"
  description="About Ignition Intel and fire investigation instructor Nicole Brewer. Placeholder description: update before launch."
>
  <main>
    <Section padding="tight">
      <Container size="wide">
        <Heading level={1}>{heading}</Heading>
      </Container>
    </Section>

    <About />
  </main>
</BaseLayout>
