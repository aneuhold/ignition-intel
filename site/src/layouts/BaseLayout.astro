---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import SiteFooter from '$components-astro/SiteFooter.astro';
import SiteHeader from '$components-astro/SiteHeader.astro';
import '../styles/global.css';
import { globalConstants } from '$util/globalConstants';
import seoGraphService from '$util/SeoGraph.service';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

if (!Astro.site) {
  throw new Error('Astro.site must be configured for canonical/OG/JSON-LD URLs.');
}

// With `build.format: 'file'` Astro reports `Astro.url.pathname` as
// `/menu.html`, but the host serves it at `/menu` — strip the extension so
// canonical, OG URL, and JSON-LD all agree on the slashless form. Astro
// does not provide a built-in helper for this; the official guidance is to
// derive the public URL yourself:
//   https://docs.astro.build/en/reference/configuration-reference/#buildformat
// `/index.html` collapses to `/`.
const canonicalUrl = new URL(Astro.url);
canonicalUrl.pathname = canonicalUrl.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');

const ogImage = new URL('/og-image.png', Astro.site).href;
const graph = await seoGraphService.buildGraph({
  site: Astro.site,
  pageUrl: canonicalUrl,
  pageName: title,
  description,
  ogImage
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      canonical={canonicalUrl}
      ogType="website"
      ogImage={ogImage}
      ogImageAlt={globalConstants.siteName}
      ogImageWidth={1200}
      ogImageHeight={630}
      siteName={globalConstants.siteName}
      locale="en_US"
      twitter={{ card: 'summary_large_image' }}
      graph={graph}
      extraLinks={[
        { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' },
        { rel: 'apple-touch-icon', href: '/apple-touch-icon.png' },
        { rel: 'manifest', href: '/site.webmanifest' }
      ]}
      extraMeta={[{ name: 'theme-color', content: globalConstants.webManifestThemeColor }]}
    />
    <Font cssVariable="--font-public-sans" preload />
    <Font cssVariable="--font-lora" preload />
    <ClientRouter />
    <!--
      Runs before first paint. Marks the document for GSAP-owned starting states
      (see motion.css) only when motion is welcome, and flags the home intro when
      home is the first page of the session.
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const motionOk = matchMedia('(prefers-reduced-motion: no-preference)').matches;
        const mark = () => {
          if (motionOk) root.dataset.motion = '';
        };
        mark();
        document.addEventListener('astro:after-swap', mark);
        try {
          if (motionOk && location.pathname === '/' && !sessionStorage.getItem('ii-visited')) {
            root.dataset.intro = '';
          }
          sessionStorage.setItem('ii-visited', '1');
        } catch {
          // Storage is blocked: skip the intro.
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col bg-background font-body text-foreground antialiased">
    <a
      href="#main"
      class="sr-only z-50 rounded-full bg-primary px-4 py-2 font-display text-sm font-bold text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <SiteHeader />
    <div
      data-transition-bar
      transition:persist
      aria-hidden="true"
      class="pointer-events-none fixed inset-x-0 top-16 z-50 h-px origin-left scale-x-0 bg-primary shadow-[0_0_1rem_var(--color-primary)]"
    >
    </div>
    <main id="main" data-page-main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import motionService from '$util/motion/Motion.service';

      motionService.init();
    </script>
  </body>
</html>
