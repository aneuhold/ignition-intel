{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ignition-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "dev": { "port": 8787, "inspector_port": 9229 },
  "secrets": {
    //   CLOUDFLARE_TURNSTILE_SECRET_KEY — Turnstile secret for server-side captcha verification
    //   RESEND_API_KEY                  — Resend API key for sending contact emails
    "required": ["CLOUDFLARE_TURNSTILE_SECRET_KEY", "RESEND_API_KEY"]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      // Bindings with the same namespace_id on the account share counters per key (here, per IP).
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
